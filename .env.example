# Sao chép thành .env ở thư mục gốc. Không commit .env.
# Tạo secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
CAFE_AUTH_SECRET=
# Đường dẫn tương đối được tính từ thư mục gốc repository.
CAFE_MODEL_DIR=models
CAFE_STORAGE_DIR=storage
# auto | cpu | cuda
CAFE_DEVICE=cpu
# Origin cách nhau bằng dấu phẩy, không thêm dấu / ở cuối. Để trống khi UI cùng server.
CAFE_CORS_ORIGINS=
